# Docker Compose configuration.
# Copy to .env (same folder as docker-compose.yml) and fill in GROQ_API_KEY.

# ---------- Required ----------
GROQ_API_KEY=your_groq_api_key

# ---------- Database (container) ----------
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm_password
POSTGRES_DB=ai_first_crm_hcp

# ---------- Optional ----------
MODEL_NAME=openai/gpt-oss-120b
# llm (default) | keyword
ROUTER_MODE=llm
# Insert sample Healthcare Professionals into an empty database
SEED_DEMO_DATA=true
# Backend URL as seen by the browser (baked into the frontend build)
VITE_API_URL=http://localhost:8000
