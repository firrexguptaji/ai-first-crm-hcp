DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/ai_first_crm_hcp

GROQ_API_KEY=your_groq_api_key
# MODEL_NAME=gemma2-9b-it  as of 2024-06-05, the model is not available anymore, so we are using the new one below

MODEL_NAME=openai/gpt-oss-120b

# llm (default): LLM routing with keyword fallback | keyword: keyword rules only
ROUTER_MODE=llm

# ---------- Tests ----------
# Separate database for database tests. Never the application database.
# Every test is rolled back, so this database stays empty.
TEST_DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/ai_first_crm_hcp_test
# Set to 1 to run tests that call the Groq API
RUN_LIVE_TESTS=0
